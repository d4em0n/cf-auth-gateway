{
  "name": "cf-auth-gateway-staging",
  "main": ".generated/worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "node scripts/prepare-worker.js profiles/librechat-v0.8.9.yaml",
  },
  "vars": {
    "ORIGIN_URL": "https://origin-staging.example.com",
  },
  "kv_namespaces": [
    {
      "binding": "RECOGNIZED",
      "id": "00000000000000000000000000000000",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_FLOW_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "UNKNOWN_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "routes": [
    {
      "pattern": "chat-staging.example.com",
      "custom_domain": true,
    },
  ],
}
