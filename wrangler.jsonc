{
  "name": "cf-auth-gateway-example",
  "main": ".generated/worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "AUTH_FLOW_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "UNKNOWN_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "build": {
    "command": "node scripts/prepare-worker.js",
  },
}
